{
  "name": "randevu-ai-voice-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Twilio <-> Gemini Live köprüsü — sesli randevu AI denemesi. Ayrı bir Render Web Service olarak barındırılır (Vercel'in serverless fonksiyonları sürekli açık WebSocket bağlantısına uygun değil).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server.ts",
    "start": "tsx server.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "express": "^4.21.2",
    "twilio": "^5.4.3",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
